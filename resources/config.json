{
    "batch_pipeline_name": "JOB NAME HERE",
    "batch_pipeline_note": "No job specific notes provided",
    "post_process_steps": [
        "enrich_with_yolo",
        "transform_persons_to_authors",
        "transform_title_from_parts"
    ],
    "post_process_arguments": {
        "enrich_with_yolo": {
            "yolo_data_path": "yolo.json"
        },
        "transform_title_from_parts": {
            "parts_to_include": [
                "title",
                "remainder_of_title"
            ]
        }
    },
    "batch_job_config": {  
        "generation_config": {
        "temperature": 1,
        "top_p": 0.95,
        "top_k": 40,
        "stopSequences": [
            "\\n\\n\\n\\n",
            "\\t\\t\\t\\t",
            "\\r\\n\\"
        ],
        "max_output_tokens": 1000,
        "response_mime_type": "application/json",
        "thinkingConfig": {
            "thinkingLevel": "LOW"
        },
        "media_resolution": "MEDIA_RESOLUTION_MEDIUM"
        },
        "tools": [],
        "model": "gemini-3.1-flash-lite-preview"
    },
    "matching_config": {
        "weights": {
            "all": 0.0,
            "title": 1.5,
            "location": 1.0,
            "year": 1.0,
            "author": 0.75
        },
        "options": {
            "force_year": true,
            "year_tolerance": null,
            "year_tolerance_penalty": 0.25,
            "include_source_data": true,
            "similarity_threshold": 0.35,
            "z_threshold": 7.0,
            "min_single_similarity": 0.5,
            "min_multiple_similarity": 0.43,
            "weights_file": null,
            "extended_output": true,
            "add_author_to_title": false,
            "overlap_adjustment": null,
            "jaro_winkler_adjustment": true,
            "jaro_winkler_author_adjustment": true,
            "json_schema_version": 2,
            "exclude_files": [],
            "input_exclude_files": [],
            "add_serial_to_title": false,
            "add_edition_to_title": false,
            "parse_year_ranges": false,
            "use_first_parsed_year": false
        },
        "source": "libris-v1_7",
        "dataset_path": "./path-to-dataset-directory"
    }
}